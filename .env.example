# ============================================================
# BotecoPRO – Environment variables example
# Copy to .env and fill in the values. NEVER commit .env.
# ============================================================

# ----- Odoo -------------------------------------------------
ODOO_DB=botecopro_dev
ODOO_ADMIN_PASSWD=change_me_before_use
ODOO_MASTER_PASSWD=change_me_before_use

# ----- PostgreSQL -------------------------------------------
POSTGRES_DB=botecopro_dev
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change_me_before_use

# ----- API --------------------------------------------------
BOTECOPRO_API_SECRET=change_me_before_use
BOTECOPRO_API_BASE_URL=http://localhost:8069

# ----- Flutter dev ------------------------------------------
# FLUTTER_API_BASE_URL=http://10.0.2.2:8069   # Android emulator
# FLUTTER_API_BASE_URL=http://localhost:8069   # iOS simulator

# ----- Website ----------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8069
