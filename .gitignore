# ============================================================
# BotecoPRO monorepo .gitignore
# ============================================================

# ----- Secrets / environment --------------------------------
.env
.env.local
.env.*.local
.envrc
*.pem
*.key
secrets/

# ----- Python / Odoo ----------------------------------------
.tools/
.artifacts/
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg
.venv/
env/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/
screenshots/
emulator-data/

# ----- Flutter / Dart ---------------------------------------
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/.packages
apps/mobile/build/
apps/mobile/.pub-cache/
apps/mobile/pubspec.lock

# ----- Node / Website ---------------------------------------
node_modules/
apps/website/node_modules/
apps/website/.next/
apps/website/out/
apps/website/.nuxt/
apps/website/dist/
apps/website/.cache/
apps/website/.parcel-cache/
packages/*/node_modules/
*.tsbuildinfo

# ----- Docker / infrastructure ------------------------------
infrastructure/docker/data/
infrastructure/odoo/filestore/
infrastructure/odoo/sessions/
*.pid
*.rdb
*.aof

# ----- Odoo --------------------------------------------------
addons/**/__pycache__/
addons/**/*.pyc

# ----- IDE --------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.DS_Store
Thumbs.db

# ----- Logs -------------------------------------------------
*.log
logs/

# ----- Public evidence --------------------------------------
# Keep the explicitly reviewed evidence set narrow. Every other screenshot is
# ignored so credentials or unrelated Odoo data cannot be added accidentally.
docs/evidence/*
!docs/evidence/README.md
!docs/evidence/odoo-authenticated.png
!docs/evidence/odoo-products.png

# ----- OS ---------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
