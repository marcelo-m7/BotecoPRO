<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_botecopro_venue_form" model="ir.ui.view">
        <field name="name">botecopro.venue.form</field>
        <field name="model">botecopro.venue</field>
        <field name="arch" type="xml">
            <form string="Venue">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="timezone"/>
                        <field name="mobile_sync_enabled"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="POS Configurations">
                            <field name="pos_config_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_botecopro_venue_tree" model="ir.ui.view">
        <field name="name">botecopro.venue.tree</field>
        <field name="model">botecopro.venue</field>
        <field name="arch" type="xml">
            <tree string="Venues">
                <field name="name"/>
                <field name="company_id"/>
                <field name="timezone"/>
                <field name="mobile_sync_enabled"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_botecopro_venue" model="ir.actions.act_window">
        <field name="name">Venues</field>
        <field name="res_model">botecopro.venue</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_botecopro_root"
              name="BotecoPRO"
              sequence="90"/>
    <menuitem id="menu_botecopro_configuration"
              name="Configuration"
              parent="menu_botecopro_root"
              sequence="100"/>
    <menuitem id="menu_botecopro_venues"
              name="Venues"
              parent="menu_botecopro_configuration"
              action="action_botecopro_venue"
              sequence="10"/>
</odoo>
